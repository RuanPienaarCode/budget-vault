# Live user settings — never commit
data.json

# Internal audit reports — keep them local. They catalogue previously-fixed
# weaknesses, which is a map worth having privately and not worth publishing
# alongside a public plugin.
AUDIT-*.html

# Internal dev docs — roadmaps, issue breakdowns, working notes. Kept local:
# they are sliced from real account statements, so their reasoning leans on
# personal financial detail. Publishable docs belong in README.md instead.
dev-docs/

# Local design-preview harness (browser mock of the plugin) — dev-only, never shipped
_preview/

# Claude Code agent files — backed up in the Claude-config repo, never committed here
.claude/agents/

# OS noise
.DS_Store

# npm build deps — the bundle is committed, its inputs are not
node_modules/

# Numbers-ledger output harvested from a REAL household (scripts/figures.cjs
# --vault). The committed ledger is tests/figures/ledger.txt, harvested from the
# synthetic household in tests/figures/household.cjs; anything under this folder
# came off someone's actual finances and this repo is public.
tests/figures/live/
